{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mtah2027/event-stream.schema.json",
  "title": "Football event stream (derived from automatic tracking)",
  "description": "Events detected from tracking + Smart Tagging. Automatic and uncorrected: treat as evidence.",
  "type": "object",
  "required": [
    "meta",
    "events"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "game",
        "fps",
        "pitch_m",
        "windows",
        "event_counts"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "game": {
          "type": "string"
        },
        "fps": {
          "type": "integer"
        },
        "pitch_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "teams": {
          "type": "object"
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "attack_direction": {
          "type": "object"
        },
        "thresholds": {
          "type": "object"
        },
        "event_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "location": {
      "type": [
        "object",
        "null"
      ],
      "description": "Pitch position in metres (x along the pitch 0..105.3, y across 0..68). x_att_m is x mirrored so the acting team always attacks towards larger values.",
      "properties": {
        "x_m": {
          "type": [
            "number",
            "null"
          ],
          "description": "Metres along the pitch."
        },
        "y_m": {
          "type": [
            "number",
            "null"
          ],
          "description": "Metres across the pitch."
        },
        "x_att_m": {
          "type": [
            "number",
            "null"
          ],
          "description": "x in the acting team's attacking direction (null if no team)."
        },
        "zone": {
          "type": [
            "string",
            "null"
          ],
          "description": "Third of the pitch relative to the acting team.",
          "enum": [
            "defensive_third",
            "middle_third",
            "final_third",
            null
          ]
        },
        "lane": {
          "type": [
            "string",
            "null"
          ],
          "description": "central = within a third of the width of the centre line.",
          "enum": [
            "central",
            "wide",
            null
          ]
        },
        "in_opponent_box": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Inside the penalty area the acting team attacks."
        },
        "in_own_box": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Inside the acting team's own penalty area."
        }
      },
      "required": [
        "x_m",
        "y_m"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "type",
        "period",
        "frame_start",
        "frame_end",
        "time_start",
        "duration_s",
        "team",
        "player_slot",
        "start_location",
        "end_location",
        "confidence",
        "sources",
        "details"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique id within the file, E00001... in time order."
        },
        "type": {
          "type": "string",
          "description": "Event type.",
          "enum": [
            "ball_out_of_play",
            "carry",
            "dead_ball",
            "duel",
            "foul_candidate",
            "goal",
            "hold",
            "interception",
            "pass",
            "possession_change",
            "restart",
            "shot",
            "tackle",
            "tracking_gap"
          ]
        },
        "subtype": {
          "type": [
            "string",
            "null"
          ],
          "description": "Type-specific refinement (see per-type constraints)."
        },
        "period": {
          "type": "integer",
          "description": "1 or 2 (half).",
          "minimum": 1
        },
        "frame_start": {
          "type": "integer",
          "description": "First video frame (0-based, tactical video).",
          "minimum": 0
        },
        "frame_end": {
          "type": "integer",
          "description": "Last video frame, inclusive.",
          "minimum": 0
        },
        "time_start": {
          "type": "string",
          "description": "Video time mm:ss.ss of frame_start (from the first frame of the video)."
        },
        "duration_s": {
          "type": "number",
          "description": "(frame_end - frame_start + 1) / 25.",
          "minimum": 0
        },
        "team": {
          "type": [
            "string",
            "null"
          ],
          "description": "Team letter: H = home (first team in the ATD metadata), A = away.",
          "enum": [
            "H",
            "A",
            null
          ]
        },
        "player_slot": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Track slot 1..46. A tracklet, NOT a person: slots swap players.",
          "minimum": 1
        },
        "start_location": {
          "$ref": "#/$defs/location"
        },
        "end_location": {
          "$ref": "#/$defs/location"
        },
        "confidence": {
          "type": "number",
          "description": "Heuristic 0..1 (ball visibility, rule strength). NOT a calibrated probability.",
          "minimum": 0,
          "maximum": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "tracking",
              "smart_tagging"
            ]
          }
        },
        "details": {
          "type": "object",
          "description": "Type-specific fields, see the per-type constraints."
        },
        "related_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "ball_out_of_play"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "exit_side": {
                    "type": "string",
                    "description": "Which line was crossed (axes of the normalised ATD coordinates).",
                    "enum": [
                      "touchline_y_min",
                      "touchline_y_max",
                      "goal_line_x_min",
                      "goal_line_x_max"
                    ]
                  },
                  "last_touch_team": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Team letter: H = home (first team in the ATD metadata), A = away.",
                    "enum": [
                      "H",
                      "A",
                      null
                    ]
                  },
                  "last_touch_slot": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Track slot 1..46. A tracklet, NOT a person: slots swap players.",
                    "minimum": 1
                  }
                },
                "required": [
                  "exit_side"
                ],
                "additionalProperties": false
              },
              "subtype": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "carry"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "distance_m": {
                    "type": "number",
                    "description": "Ball displacement during the spell.",
                    "minimum": 0
                  },
                  "progressive_m": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Metres gained towards the opponent goal."
                  },
                  "mean_speed_ms": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "distance / duration.",
                    "minimum": 0
                  },
                  "nearest_opponent_min_m": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Closest tracked opponent during the carry.",
                    "minimum": 0
                  },
                  "under_pressure": {
                    "type": "boolean",
                    "description": "An opponent came within the pressure distance."
                  },
                  "is_dribble": {
                    "type": "boolean",
                    "description": "Carry with an opponent within dribble_m at some point."
                  },
                  "into_final_third": {
                    "type": "boolean",
                    "description": "Starts outside, ends inside the attacking third."
                  },
                  "into_box": {
                    "type": "boolean",
                    "description": "Starts outside, ends inside the opponent penalty area."
                  },
                  "ball_seen_share": {
                    "type": "number",
                    "description": "Share of frames with a real ball detection.",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "distance_m",
                  "under_pressure",
                  "is_dribble"
                ],
                "additionalProperties": false
              },
              "subtype": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dead_ball"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "description": "Why the stretch is dead.",
                    "enum": [
                      "out_of_pitch",
                      "long_ball_gap",
                      "before_kickoff",
                      "stoppage"
                    ]
                  }
                },
                "required": [
                  "reason"
                ],
                "additionalProperties": false
              },
              "subtype": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "duel"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "home_slot": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Track slot 1..46. A tracklet, NOT a person: slots swap players.",
                    "minimum": 1
                  },
                  "away_slot": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Track slot 1..46. A tracklet, NOT a person: slots swap players.",
                    "minimum": 1
                  },
                  "winner_team": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Team letter: H = home (first team in the ATD metadata), A = away.",
                    "enum": [
                      "H",
                      "A",
                      null
                    ]
                  },
                  "min_player_distance_m": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Closest the two nearest players got.",
                    "minimum": 0
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "subtype": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "foul_candidate"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "offending_team": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Team letter: H = home (first team in the ATD metadata), A = away.",
                    "enum": [
                      "H",
                      "A",
                      null
                    ]
                  },
                  "fouled_team": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Team letter: H = home (first team in the ATD metadata), A = away.",
                    "enum": [
                      "H",
                      "A",
                      null
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Reasons for the call, e.g. free_kick_tag, preceding_duel."
                  },
                  "in_penalty_area": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Ball inside the offending team's own penalty area at the stoppage."
                  },
                  "players_within_5m": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Tracked players within 5 m of the ball at the stoppage.",
                    "minimum": 0
                  },
                  "preceding_event_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Event id of a related event (same file)."
                  }
                },
                "required": [
                  "evidence"
                ],
                "additionalProperties": false
              },
              "subtype": {
                "enum": [
                  "free_kick_stoppage",
                  "penalty_candidate",
                  null
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "goal"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "tag_frame_start": {
                    "type": "integer",
                    "description": "First frame of the tagged interval."
                  },
                  "tag_frame_end": {
                    "type": "integer",
                    "description": "Last frame of the tagged interval."
                  },
                  "shot_event_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Event id of a related event (same file)."
                  }
                },
                "required": [
                  "tag_frame_start",
                  "tag_frame_end"
                ],
                "additionalProperties": false
              },
              "subtype": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hold"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "nearest_opponent_min_m": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Closest tracked opponent during the hold.",
                    "minimum": 0
                  },
                  "under_pressure": {
                    "type": "boolean",
                    "description": "An opponent came within the pressure distance."
                  },
                  "ball_seen_share": {
                    "type": "number",
                    "description": "Share of frames with a real ball detection.",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "under_pressure"
                ],
                "additionalProperties": false
              },
              "subtype": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "interception"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "intercepted_pass_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Event id of a related event (same file)."
                  },
                  "passer_slot": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Track slot 1..46. A tracklet, NOT a person: slots swap players.",
                    "minimum": 1
                  },
                  "passer_team": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Team letter: H = home (first team in the ATD metadata), A = away.",
                    "enum": [
                      "H",
                      "A",
                      null
                    ]
                  },
                  "flight_frames": {
                    "type": "integer",
                    "description": "Free-flight frames before the interception.",
                    "minimum": 0
                  },
                  "distance_from_passer_m": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Ball displacement release -> interception.",
                    "minimum": 0
                  }
                },
                "required": [
                  "flight_frames"
                ],
                "additionalProperties": false
              },
              "subtype": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pass"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "outcome": {
                    "type": "string",
                    "description": "complete = received by a teammate; intercepted = received by an opponent.",
                    "enum": [
                      "complete",
                      "intercepted"
                    ]
                  },
                  "recipient_slot": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Track slot 1..46. A tracklet, NOT a person: slots swap players.",
                    "minimum": 1
                  },
                  "recipient_team": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Team letter: H = home (first team in the ATD metadata), A = away.",
                    "enum": [
                      "H",
                      "A",
                      null
                    ]
                  },
                  "length_m": {
                    "type": "number",
                    "description": "Straight-line ball displacement, metres.",
                    "minimum": 0
                  },
                  "length_class": {
                    "type": "string",
                    "description": "short / medium / long by length.",
                    "enum": [
                      "short",
                      "medium",
                      "long"
                    ]
                  },
                  "direction": {
                    "type": "string",
                    "description": "Relative to the passer's attacking direction (45 degree sectors).",
                    "enum": [
                      "forward",
                      "lateral",
                      "backward"
                    ]
                  },
                  "angle_deg": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "0 = straight at the opponent goal, +-180 = straight back."
                  },
                  "progressive_m": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Metres gained towards the opponent goal (negative = backwards)."
                  },
                  "flight_frames": {
                    "type": "integer",
                    "description": "Frames with nobody in control between release and reception.",
                    "minimum": 0
                  },
                  "max_ball_speed_ms": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Peak smoothed ball speed during the pass.",
                    "minimum": 0
                  },
                  "ball_seen_share": {
                    "type": "number",
                    "description": "Share of flight frames with a REAL ball detection (not interpolated).",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "is_cross": {
                    "type": "boolean",
                    "description": "Released from a wide area of the final third, ending in the opponent box."
                  },
                  "is_switch_of_play": {
                    "type": "boolean",
                    "description": "Mostly lateral and >= switch_min_m across the pitch."
                  },
                  "into_final_third": {
                    "type": "boolean",
                    "description": "Starts outside, ends inside the attacking third."
                  },
                  "into_box": {
                    "type": "boolean",
                    "description": "Starts outside, ends inside the opponent penalty area."
                  },
                  "nearest_opponent_m": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Distance from the passer to the nearest tracked opponent at release.",
                    "minimum": 0
                  },
                  "under_pressure": {
                    "type": "boolean",
                    "description": "nearest_opponent_m below the pressure threshold."
                  }
                },
                "required": [
                  "outcome",
                  "length_m",
                  "length_class",
                  "direction",
                  "flight_frames"
                ],
                "additionalProperties": false
              },
              "subtype": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "possession_change"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "from_team": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Team letter: H = home (first team in the ATD metadata), A = away.",
                    "enum": [
                      "H",
                      "A",
                      null
                    ]
                  },
                  "to_team": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Team letter: H = home (first team in the ATD metadata), A = away.",
                    "enum": [
                      "H",
                      "A",
                      null
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "description": "How it happened.",
                    "enum": [
                      "tackle",
                      "interception",
                      "contest",
                      "loose_ball_recovery"
                    ]
                  },
                  "trigger_event_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Event id of a related event (same file)."
                  },
                  "flight_frames": {
                    "type": "integer",
                    "description": "Free-flight frames between the two controls.",
                    "minimum": 0
                  },
                  "new_team_hold_s": {
                    "type": "number",
                    "description": "How long the new team kept the ball in the first spell.",
                    "minimum": 0
                  }
                },
                "required": [
                  "from_team",
                  "to_team",
                  "kind"
                ],
                "additionalProperties": false
              },
              "subtype": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "restart"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "restart_team": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Team letter: H = home (first team in the ATD metadata), A = away.",
                    "enum": [
                      "H",
                      "A",
                      null
                    ]
                  },
                  "team_source": {
                    "type": "string",
                    "description": "Where restart_team comes from.",
                    "enum": [
                      "smart_tagging",
                      "inferred_opposite_of_last_touch",
                      "first_control",
                      "unknown"
                    ]
                  },
                  "type_source": {
                    "type": "string",
                    "description": "Where the subtype comes from.",
                    "enum": [
                      "smart_tagging",
                      "inferred",
                      "unknown"
                    ]
                  },
                  "taker_slot": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Track slot 1..46. A tracklet, NOT a person: slots swap players.",
                    "minimum": 1
                  },
                  "set_piece_tag_frames": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "description": "[start_frame, end_frame] of the matched tag, if any."
                  },
                  "dead_ball_event_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Event id of a related event (same file)."
                  }
                },
                "required": [
                  "team_source",
                  "type_source"
                ],
                "additionalProperties": false
              },
              "subtype": {
                "enum": [
                  "throw_in",
                  "corner_kick",
                  "goal_kick",
                  "free_kick",
                  "kick_off",
